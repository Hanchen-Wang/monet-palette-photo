{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monet Transformation Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "strength",
    "presentation_profile",
    "shape_abstraction",
    "source_pixel_policy",
    "source_orientation",
    "semantic_anchor",
    "primary_subject",
    "supporting_elements",
    "spatial_invariants",
    "protected_elements",
    "discard",
    "impressionability_candidates",
    "primary_monet_zone",
    "primary_zone_override",
    "secondary_monet_zones",
    "preserve_photo_zones",
    "simplify_zones",
    "line_zones",
    "negative_space_zones",
    "light_card",
    "palette_families",
    "brush_map",
    "edge_map",
    "background_treatment",
    "transition_strategy",
    "composition",
    "visible_text"
  ],
  "properties": {
    "mode": {
      "enum": [
        "full_impression",
        "subject_monetization",
        "atmospheric_monetization",
        "zine_hybrid",
        "distilled_monet"
      ]
    },
    "strength": {"enum": ["M1", "M2", "M3", "M4"]},
    "presentation_profile": {"enum": ["immersive", "sparse_social"]},
    "shape_abstraction": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_minimum",
            "dominant_gesture",
            "source_shape_candidates",
            "retain",
            "merge",
            "omit",
            "transform",
            "expose",
            "primary_grammar",
            "supporting_grammar",
            "detail_removal_percent",
            "quiet_area_percent",
            "active_shape_percent",
            "thumbnail_anchor"
          ],
          "properties": {
            "semantic_minimum": {"type": "string", "minLength": 3},
            "dominant_gesture": {"type": "string", "minLength": 3},
            "source_shape_candidates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {"type": "string", "minLength": 1}
            },
            "retain": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {"type": "string", "minLength": 1}
            },
            "merge": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "omit": {"$ref": "#/$defs/nonEmptyStrings"},
            "transform": {"$ref": "#/$defs/nonEmptyStrings"},
            "expose": {"$ref": "#/$defs/nonEmptyStrings"},
            "primary_grammar": {"$ref": "#/$defs/graphicGrammar"},
            "supporting_grammar": {
              "oneOf": [{"$ref": "#/$defs/graphicGrammar"}, {"type": "null"}]
            },
            "detail_removal_percent": {"type": "integer", "minimum": 60, "maximum": 90},
            "quiet_area_percent": {"type": "integer", "minimum": 45, "maximum": 85},
            "active_shape_percent": {"type": "integer", "minimum": 10, "maximum": 35},
            "thumbnail_anchor": {"type": "string", "minLength": 3}
          }
        }
      ]
    },
    "source_pixel_policy": {"enum": ["none_retained", "partial_required"]},
    "source_orientation": {"enum": ["portrait", "landscape", "square"]},
    "semantic_anchor": {"type": "string", "minLength": 3},
    "primary_subject": {"type": "string", "minLength": 1},
    "supporting_elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "spatial_invariants": {"$ref": "#/$defs/nonEmptyStrings"},
    "protected_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "discard": {"$ref": "#/$defs/nonEmptyStrings"},
    "impressionability_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone", "light", "atmosphere", "reflection", "color_variation", "edge_instability", "total", "rationale"],
        "properties": {
          "zone": {"type": "string", "minLength": 1},
          "light": {"type": "integer", "minimum": 0, "maximum": 4},
          "atmosphere": {"type": "integer", "minimum": 0, "maximum": 4},
          "reflection": {"type": "integer", "minimum": 0, "maximum": 4},
          "color_variation": {"type": "integer", "minimum": 0, "maximum": 4},
          "edge_instability": {"type": "integer", "minimum": 0, "maximum": 4},
          "total": {"type": "integer", "minimum": 0, "maximum": 20},
          "rationale": {"type": "string", "minLength": 5}
        }
      }
    },
    "primary_monet_zone": {"type": "string", "minLength": 1},
    "primary_zone_override": {"type": "string"},
    "secondary_monet_zones": {
      "type": "array",
      "maxItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "preserve_photo_zones": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "simplify_zones": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "line_zones": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "negative_space_zones": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "light_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "temperature", "intensity", "diffusion", "time_or_condition", "surface_interactions", "highlight_family", "shadow_family", "reflection_relation"],
      "properties": {
        "direction": {"type": "string", "minLength": 1},
        "temperature": {"type": "string", "minLength": 1},
        "intensity": {"type": "string", "minLength": 1},
        "diffusion": {"type": "string", "minLength": 1},
        "time_or_condition": {"type": "string", "minLength": 1},
        "surface_interactions": {"$ref": "#/$defs/nonEmptyStrings"},
        "highlight_family": {"type": "string", "minLength": 1},
        "shadow_family": {"type": "string", "minLength": 1},
        "reflection_relation": {"type": "string", "minLength": 1}
      }
    },
    "palette_families": {
      "type": "array",
      "minItems": 5,
      "maxItems": 9,
      "items": {"type": "string", "minLength": 1}
    },
    "brush_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone", "primary_family", "supporting_family", "direction", "scale", "density"],
        "properties": {
          "zone": {"type": "string", "minLength": 1},
          "primary_family": {"$ref": "#/$defs/brushFamily"},
          "supporting_family": {
            "oneOf": [{"$ref": "#/$defs/brushFamily"}, {"type": "null"}]
          },
          "direction": {"type": "string", "minLength": 1},
          "scale": {"type": "string", "minLength": 1},
          "density": {"type": "string", "minLength": 1}
        }
      }
    },
    "edge_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone", "level", "reason"],
        "properties": {
          "zone": {"type": "string", "minLength": 1},
          "level": {"enum": ["L1", "L2", "L3", "L4"]},
          "reason": {"type": "string", "minLength": 3}
        }
      }
    },
    "background_treatment": {"enum": ["preserve", "simplify", "line", "paper"]},
    "transition_strategy": {
      "enum": ["brush_intrusion", "dissolve", "light_bridge", "reflection_bridge", "torn_field", "none"]
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focal_order", "eye_path", "crop_ratio", "source_allocation"],
      "properties": {
        "focal_order": {"$ref": "#/$defs/nonEmptyStrings"},
        "eye_path": {"type": "string", "minLength": 3},
        "crop_ratio": {"type": "string", "minLength": 1},
        "source_allocation": {"type": "string", "minLength": 3}
      }
    },
    "visible_text": {"type": "string", "maxLength": 80}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"enum": ["atmospheric_monetization", "zine_hybrid"]}}},
      "then": {
        "properties": {
          "source_pixel_policy": {"const": "partial_required"},
          "preserve_photo_zones": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"enum": ["full_impression", "subject_monetization", "distilled_monet"]}}},
      "then": {
        "properties": {
          "source_pixel_policy": {"const": "none_retained"},
          "preserve_photo_zones": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"not": {"const": "zine_hybrid"}}}},
      "then": {"properties": {"transition_strategy": {"not": {"const": "torn_field"}}}}
    },
    {
      "if": {"properties": {"presentation_profile": {"const": "sparse_social"}}},
      "then": {
        "properties": {
          "shape_abstraction": {"type": "object"},
          "negative_space_zones": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"presentation_profile": {"const": "immersive"}}},
      "then": {"properties": {"shape_abstraction": {"type": "null"}}}
    }
  ],
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "brushFamily": {
      "enum": [
        "broken_dabs",
        "short_directional",
        "horizontal_shimmer",
        "vertical_veil",
        "broad_flat_patches",
        "feathered_atmosphere"
      ]
    },
    "graphicGrammar": {
      "enum": ["silhouette", "contour", "field", "rhythm", "cutout"]
    }
  }
}
